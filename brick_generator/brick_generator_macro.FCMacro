"""
Parametric Brick Generator Macro v6.0.0

Fully parametric: change BondPattern, BrickWidth, MortarDepth, etc. in the
Properties panel and the brickwork regenerates automatically.

ARCHITECTURAL CHANGE from v5.x:
  Previous versions modified the source wall in-place (destructive/irreversible).
  v6.0 creates a parametric BrickedWall output object that is a modified COPY of
  the source shape.  The source wall is unchanged.
  → Hide the source wall; use the BrickedWall output for export/printing.

WORKFLOW:
1. Select one or more faces on a wall
2. Run this macro
3. BrickedWall appears — hide the original wall
4. Adjust BondPattern, BrickWidth, MortarDepth, etc. in the Properties panel

Version History:
- 6.0.0: FeaturePython conversion — fully parametric, non-destructive output.
         Generation logic moved to brick_proxy.py.
         Source wall unchanged; BrickedWall is a modified copy.
- 5.4.1: Log version on startup.
- 5.4.0: Delete dead sketch workflow; fix mortarDepth spreadsheet alias.
- 5.3.0: Transaction wrapping for undo.
- 5.2.0: Remove U snap; brick clipping at window edges.
- 5.0.0: Engraved mortar approach (pockets cut INTO wall).
"""

import FreeCAD as App
import FreeCADGui as Gui
import sys

from brick_proxy import BrickProxy, BrickViewProxy, VERSION

App.Console.PrintMessage(f"Brick Generator v{VERSION}\n")


def _get_spreadsheet_params(doc):
    """Read brick parameters from spreadsheet. Returns {} if not found."""
    preferred = ["params", "BuildingParameters", "Spreadsheet"]
    ss = None
    for name in preferred:
        obj = doc.getObject(name)
        if obj:
            if obj.TypeId == 'App::Link':
                t = obj.LinkedObject
                if t and t.TypeId == 'Spreadsheet::Sheet':
                    ss = t
                    break
            elif obj.TypeId == 'Spreadsheet::Sheet':
                ss = obj
                break
        for o in doc.Objects:
            if o.Label == name:
                if o.TypeId == 'App::Link':
                    t = o.LinkedObject
                    if t and t.TypeId == 'Spreadsheet::Sheet':
                        ss = t
                        break
                elif o.TypeId == 'Spreadsheet::Sheet':
                    ss = o
                    break
        if ss:
            break

    if ss is None:
        return {}

    params = {}
    aliases = {
        'brick_width':        'brickWidth',
        'brick_height':       'brickHeight',
        'brick_depth':        'brickDepth',
        'mortar':             'mortar',
        'bond_type':          'bondType',
        'common_bond_count':  'commonBondCount',
        'material_thickness': 'materialThickness',
        'mortar_depth':       'mortarDepth',
    }
    for key, alias in aliases.items():
        try:
            val = ss.get(alias)
            if val is not None:
                params[key] = str(val) if key == 'bond_type' else float(val)
        except Exception:
            pass
    return params


def main():
    sel = Gui.Selection.getSelectionEx()
    if not sel:
        App.Console.PrintError(
            "Nothing selected — please select one or more faces on a wall.\n")
        return

    if not sel[0].HasSubObjects:
        App.Console.PrintError(
            "Select specific faces (not the whole object).\n"
            "Ctrl+click faces in the 3D view, then run.\n")
        return

    sel_obj = sel[0].Object
    sub_elements = [s for s in sel[0].SubElementNames if s.startswith('Face')]
    if not sub_elements:
        App.Console.PrintError("No faces in selection.\n")
        return

    App.Console.PrintMessage(
        f"Brick Generator v{VERSION}: {len(sub_elements)} face(s) on '{sel_obj.Label}'\n")

    doc = App.ActiveDocument
    if not doc:
        doc = App.newDocument("BrickProject")

    params = _get_spreadsheet_params(doc)
    if params:
        App.Console.PrintMessage("Using parameters from spreadsheet\n")
    else:
        App.Console.PrintMessage("Using HO scale defaults\n")

    link_sub = [(sel_obj, tuple(sub_elements))]
    obj_label = sel_obj.Label

    doc.openTransaction(f"brick_generator: BrickedWall_{obj_label}")
    try:
        obj = doc.addObject("Part::FeaturePython", f"BrickedWall_{obj_label}")
        BrickProxy(obj)
        BrickViewProxy(obj.ViewObject)

        BrickProxy.set_defaults(obj, params)
        obj.Sources = link_sub

        # Match source color
        try:
            obj.ViewObject.ShapeColor = sel_obj.ViewObject.ShapeColor
        except Exception:
            pass

        doc.recompute()
        doc.commitTransaction()
    except Exception:
        doc.abortTransaction()
        raise

    App.Console.PrintMessage(
        f"\n✓ Parametric BrickedWall_{obj_label} created.\n"
        f"  Hide '{obj_label}' (the source wall) to see the result.\n"
        f"  Adjust BondPattern, BrickWidth, MortarDepth, etc. in Properties.\n\n")


if __name__ == '__main__':
    main()
